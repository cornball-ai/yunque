\name{bmul}
\alias{bmul}
\title{Broadcasting multiplication}
\usage{
bmul(x, y)
}
\arguments{
\item{x}{AnvlArray, or a single number.}

\item{y}{AnvlArray, or a single number.}
}
\description{
\code{x * y} with numpy-style broadcasting; see \link{broadcasting}.
}
